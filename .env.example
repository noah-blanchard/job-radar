# ===== JobRadar : .env =====
# Copier en .env (ou coller dans l'onglet "Environment" de Dokploy), remplir, ne jamais commit.
# Commentaires TOUJOURS sur leur propre ligne : avec `CLE=   # commentaire`, Docker Compose
# prend "# commentaire" pour la valeur.

# --- Général ---
TZ=America/Toronto
NODE_ENV=production
# Liens dans les alertes ; https => cookie de session "Secure".
PUBLIC_BASE_URL=https://jobs.sonomusa.tech
# Mis dans le User-Agent des requêtes (obligatoire en pratique : politesse envers les API).
CONTACT_EMAIL=

# --- Base de données ---
POSTGRES_USER=jobradar
# Mot de passe fort (n'importe quels caractères sauf $).
POSTGRES_PASSWORD=
POSTGRES_DB=jobradar
# Utilisé uniquement HORS Docker (pnpm dev, drizzle-kit) via le port local 127.0.0.1:5432.
# Dans docker-compose, DATABASE_URL est réécrit (host "db") et les identifiants passent par PGUSER/PGPASSWORD.
DATABASE_URL=postgres://jobradar:${POSTGRES_PASSWORD}@localhost:5432/jobradar

# --- Dashboard ---
# 8 caractères minimum.
DASHBOARD_PASSWORD=
# >= 32 caractères : openssl rand -base64 32
AUTH_SECRET=

# --- Backups (service "backup" : pg_dump quotidien, volume "backups") ---
# Heure du dump (Toronto) et nombre de jours conservés.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=14

# --- Worker ---
# GET /healthz (non exposé publiquement).
WORKER_HEALTH_PORT=8081

# --- Sources : agrégateurs avec clé ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=ca,us,fr,gb
ADZUNA_DAILY_MAX_CALLS=200

JOOBLE_KEY=
JOOBLE_DAILY_MAX_CALLS=100

# France Travail (source désactivée : voir SOURCES.md).
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_DAILY_MAX_CALLS=100

# JSearch (RapidAPI). Plan gratuit : 200 requêtes/mois, d'où 3 par jour.
RAPIDAPI_KEY=
JSEARCH_DAILY_MAX_CALLS=3

# Findwork : en plus du quota, 10 req/min (cadencé par le worker).
FINDWORK_KEY=
FINDWORK_DAILY_MAX_CALLS=50

# --- Sources : facultatives ---
# Optionnel : jamais envoyé par le worker (listes lues sur raw.githubusercontent).
GITHUB_TOKEN=
# Inutilisé : l'API publique The Muse répond 404.
THEMUSE_KEY=
# Requis pour Careerjet (source désactivée sans).
CAREERJET_AFFID=
# API allemande : 403 avec la clé publique (désactivée).
BA_JOBSUCHE_ENABLED=false

# --- Planification (heure de Toronto) ---
ATS_CRON=0 */6 * * *
AGGREGATORS_CRON=30 5 * * *
FEEDS_CRON=15 */6 * * *
DIGEST_CRON=0 8 * * *
HTTP_CONCURRENCY_PER_HOST=2
WORKDAY_MIN_INTERVAL_MS=1000
# Budget d'un balayage ATS ; les entreprises non atteintes passent en tête au suivant.
ATS_SWEEP_MAX_MINUTES=330

# --- Alertes : seuils ---
DIGEST_MIN_SCORE=40
INSTANT_ALERTS_ENABLED=true
INSTANT_MIN_SCORE=75
HEALTH_SILENCE_HOURS=12

# --- Alertes : ntfy (canal activé si NTFY_TOPIC est rempli) ---
# ntfy.sh ou ton instance Dokploy.
NTFY_URL=https://ntfy.sh
# Nom difficile à deviner (A-Z a-z 0-9 - _, 64 max) : sur ntfy.sh, qui connaît le topic lit les alertes.
NTFY_TOPIC=
# Seulement si le topic est protégé : jeton d'accès ntfy (commence par tk_).
NTFY_TOKEN=

# --- Alertes : e-mail (canal activé si SMTP_HOST et ALERT_EMAIL_TO sont remplis) ---
SMTP_HOST=
SMTP_PORT=587
# true si port 465.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JobRadar <jobradar@sonomusa.tech>"
ALERT_EMAIL_TO=

# --- Alertes : facultatives ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (facultatif) ---
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_DAILY_MAX_CALLS=200

# --- Logs ---
LOG_LEVEL=info
