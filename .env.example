# ===== JobRadar : .env =====
# Copier en .env, remplir, ne jamais commit.

# --- Général ---
TZ=America/Toronto
NODE_ENV=production
PUBLIC_BASE_URL=https://jobs.sonomusa.tech      # liens dans les alertes ; https => cookie de session "Secure"
CONTACT_EMAIL=                                  # mis dans le User-Agent des requêtes

# --- Base de données ---
POSTGRES_USER=jobradar
POSTGRES_PASSWORD=                              # mot de passe fort (n'importe quels caractères sauf $)
POSTGRES_DB=jobradar
# Utilisé uniquement HORS Docker (pnpm dev, drizzle-kit) via le port local 127.0.0.1:5432.
# Dans docker-compose, DATABASE_URL est réécrit (host "db") et les identifiants passent par PGUSER/PGPASSWORD.
DATABASE_URL=postgres://jobradar:${POSTGRES_PASSWORD}@localhost:5432/jobradar

# --- Dashboard ---
DASHBOARD_PASSWORD=                             # 8 caractères minimum
AUTH_SECRET=                                    # >= 32 caractères : openssl rand -base64 32

# --- Worker ---
WORKER_HEALTH_PORT=8081                         # GET /healthz (non exposé publiquement)

# --- Sources : agrégateurs avec clé ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=ca,us,fr,gb
ADZUNA_DAILY_MAX_CALLS=200

JOOBLE_KEY=
JOOBLE_DAILY_MAX_CALLS=100

FT_CLIENT_ID=                                   # France Travail (source désactivée : voir SOURCES.md)
FT_CLIENT_SECRET=
FT_DAILY_MAX_CALLS=100

RAPIDAPI_KEY=                                   # JSearch
JSEARCH_DAILY_MAX_CALLS=3                       # plan gratuit RapidAPI : 200 requêtes/mois

FINDWORK_KEY=
FINDWORK_DAILY_MAX_CALLS=50                     # en plus : 10 req/min (cadencé par le worker)

# --- Sources : facultatives ---
GITHUB_TOKEN=                                   # optionnel : jamais envoyé par le worker (listes lues sur raw.githubusercontent)
THEMUSE_KEY=                                    # inutilisé : l'API publique The Muse répond 404
CAREERJET_AFFID=                                # requis pour Careerjet (source désactivée sans)
BA_JOBSUCHE_ENABLED=false                       # API allemande : 403 avec la clé publique (désactivée)

# --- Planification ---
ATS_CRON=0 */6 * * *
AGGREGATORS_CRON=30 5 * * *
FEEDS_CRON=15 */6 * * *
DIGEST_CRON=0 8 * * *
HTTP_CONCURRENCY_PER_HOST=2
WORKDAY_MIN_INTERVAL_MS=1000
ATS_SWEEP_MAX_MINUTES=330                       # budget d'un balayage ATS ; les entreprises non atteintes passent en tête au suivant

# --- Alertes : seuils ---
DIGEST_MIN_SCORE=40
INSTANT_ALERTS_ENABLED=true
INSTANT_MIN_SCORE=75
HEALTH_SILENCE_HOURS=12

# --- Alertes : ntfy ---
NTFY_URL=https://ntfy.sh                        # ou ton instance Dokploy
NTFY_TOPIC=                                     # nom difficile à deviner
NTFY_TOKEN=                                     # si instance protégée

# --- Alertes : e-mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false                               # true si port 465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="JobRadar <jobradar@sonomusa.tech>"
ALERT_EMAIL_TO=

# --- Alertes : facultatives ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM (facultatif) ---
LLM_ENABLED=false
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_DAILY_MAX_CALLS=200

# --- Logs ---
LOG_LEVEL=info
