{
  "name": "jobradar",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "pnpm --filter @jobradar/web dev",
    "dev:worker": "pnpm --filter @jobradar/worker dev",
    "db:generate": "pnpm --filter @jobradar/db generate",
    "db:migrate": "pnpm --filter @jobradar/db migrate",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
