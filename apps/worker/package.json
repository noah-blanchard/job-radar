{
  "name": "@jobradar/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local src/index.ts",
    "cli": "tsx --env-file-if-exists=../../.env.local src/cli.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jobradar/core": "workspace:*",
    "@jobradar/db": "workspace:*",
    "croner": "^11.0.0"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "tsx": "^4.23.15"
  }
}
